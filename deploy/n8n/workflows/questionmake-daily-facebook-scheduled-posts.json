    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sp.id AS sp_id, mu.id AS mu_id, mu.original_file_url,\n  COALESCE(mu.ai_facebook_title, mu.edited_title, mu.ai_content_summary) AS title,\n  COALESCE(\n    NULLIF(TRIM(mu.ai_facebook_description), ''),\n    NULLIF(TRIM(mu.edited_description), ''),\n    NULLIF(TRIM(mu.ai_raw_content), ''),\n    ''\n  ) AS description,\n  mu.ai_facebook_hashtags AS hashtags\nFROM scheduled_posts sp\nJOIN media_uploads mu ON mu.id = sp.media_upload_id\nWHERE sp.status = 'pending'\n  AND mu.platform IN ('facebook','both')\n  AND mu.status = 'processed'\nORDER BY sp.scheduled_date ASC, sp.position ASC\nLIMIT 1",
        "options": {}
      },
      "id": "mysql-select-1",
      "name": "Get Due Posts",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "mySql": {
          "id": "QxQz8ESa93bbcEkj",
          "name": "Questionmake MySQL"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nlet hashtags = item.hashtags;\nif (typeof hashtags === 'string') {\n  try { hashtags = JSON.parse(hashtags); } catch (e) { hashtags = []; }\n}\nif (!Array.isArray(hashtags)) hashtags = [];\nconst hashtagStr = hashtags.map(h => (h.startsWith('#') ? h : '#' + h)).join(' ');\nconst hasContent = !!(item.description && item.description.trim().length > 0);\nconst caption = [item.title, item.description, hashtagStr].filter(Boolean).join('\\n\\n');\nreturn { json: { ...item, caption, hasContent } };"
      },
      "id": "code-caption-1",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
