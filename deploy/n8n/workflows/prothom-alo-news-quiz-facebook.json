{
  "name": "Prothom Alo News Quiz - Facebook",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "feedUrl": "https://www.prothomalo.com/feed",
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 2,
