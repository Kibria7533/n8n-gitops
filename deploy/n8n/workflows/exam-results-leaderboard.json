    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, exam_name, examCode, duration\nFROM online_exam\nWHERE exam_mode = 'LIVE_QUIZ'\n  AND completed = 0\n  AND scheduled_start_time IS NOT NULL\n  AND scheduled_start_time + INTERVAL (duration + 15) MINUTE < NOW()",
        "options": {}
      },
      "id": "mysql-find-ended-1",
      "name": "Find Exams Needing Results",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "mySql": {
          "id": "QxQz8ESa93bbcEkj",
          "name": "Questionmake MySQL"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.questionhut.com/api/public/results/live-leaderboard/{{$json.examCode}}",
        "options": {}
      },
      "id": "http-get-leaderboard-1",
      "name": "Get Leaderboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst examInfo = $('Find Exams Needing Results').item.json;\n\nconst users = Array.isArray(item.joined_users) ? item.joined_users : [];\n\nlet message;\nif (users.length === 0) {\n  message = `\\ud83d\\udcca ${examInfo.exam_name} has ended. No participants joined this time \\u2014 stay tuned for the next one!`;\n} else {\n  const top = users.slice(0, 5);\n  const medals = ['\\ud83e\\udd47', '\\ud83e\\udd48', '\\ud83e\\udd49'];\n  const board = top.map((u, i) => `${medals[i] || (i + 1) + '.'} ${u.name} \\u2014 ${u.correctAnswers} correct`).join('\\n');\n  message = `\\ud83c\\udfc6 Results are in for ${examInfo.exam_name}!\\n\\n${board}\\n\\nThanks to everyone who joined! \\ud83c\\udf89\\nNext quiz coming soon \\u2014 stay tuned.`;\n}\n\nreturn {\n  json: {\n    exam_id: examInfo.id,\n    exam_name: examInfo.exam_name,\n    examCode: examInfo.examCode,\n    message\n  }\n};"
      },
      "id": "code-build-leaderboard-msg-1",
      "name": "Build Leaderboard Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
